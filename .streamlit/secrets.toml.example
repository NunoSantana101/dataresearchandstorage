# Copy this file to `.streamlit/secrets.toml` and fill in your key.
# `.streamlit/secrets.toml` is gitignored so your key never gets committed.

# Required for the nano structuring pass.
OPENAI_API_KEY = "sk-..."

# Optional. An NCBI E-utils key raises the PubMed rate limit from 3 to 10 req/s.
# Leave unset for casual testing — the public endpoint works without it.
NCBI_API_KEY = ""

# Optional NCBI politeness identifiers (recommended by NCBI, not required).
NCBI_TOOL = "saimone-pubmed-collector"
NCBI_EMAIL = ""
